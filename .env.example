# ======================================================================
# pm-system 环境变量模板
# ----------------------------------------------------------------------
# 用法：复制本文件为 .env，填入真实值。.env 已在 .gitignore 中排除，
#       绝不会被提交。本模板只放占位符，不放任何真实凭据。
#
#   cp .env.example .env
#   vim .env          # 填入真实值
#   docker compose up -d
#
# 说明：每个变量都对应 backend/src/main/resources/application.yml 里的
#       ${VAR:default} 占位符。不设则使用代码里的本地开发默认值。
# ======================================================================

# ---- 后端服务 ----
SERVER_PORT=8080

# ---- MySQL ----
# 容器内互访用服务名 mysql；宿主机本地开发用 localhost
DB_URL=jdbc:mysql://mysql:3306/pm_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
# 改成一个强密码，不要用 123456
DB_PASSWORD=change-me-strong-password

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=change-me-redis-password

# ---- JWT ----
# HS256 要求至少 32 字符；生产环境必须替换，生成方式示例：
#   openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-characters-long-random-string
JWT_EXPIRE=7200

# ---- 附件存储 ----
# 容器内路径，与 compose 中的具名卷挂载点一致
PM_UPLOAD_DIR=/pm-upload

# ---- 前端访问后端的跨域白名单（逗号分隔）----
# 生产环境经 nginx 同源反向代理（前端和 /api 同域），浏览器视为同源，
# 因此这里保持默认即可；仅当确有独立域名跨域调用时才追加白名单，
# 切勿填 *（配合 allowCredentials 会放大 CSRF 风险）。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# ---- SQL 日志 ----
# 开发期打印 SQL 到控制台；生产建议打开下面一行，避免日志刷屏与信息泄露
SQL_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl
# SQL_LOG_IMPL=org.apache.ibatis.logging.nologging.NoLoggingImpl
