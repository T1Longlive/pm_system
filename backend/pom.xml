<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot 父工程：统一管理依赖版本 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!--
          Spring Boot 4.1.1（2026-09 升级）

          为什么升：原 3.2.5 的 OSS 支持已于 2024-12-31 结束，整个 3.x 分支
          （含 3.5，2026-06-30 EOL）都不再有安全补丁。Trivy 首次扫描后端镜像报出
          41 条漏洞（CRITICAL 8 / HIGH 33），其中两条 CRITICAL 来自 Spring Boot
          内置的组件：
            · tomcat-embed-core  CVE-2025-24813（RCE，10.1.20 → 修 10.1.35）
            · netty-handler      CVE-2026-75595
          这些靠重新拉基础镜像解决不了 —— 版本是 Spring Boot 的 BOM 决定的，
          只能升 Spring Boot。

          Spring Boot 4.x 基线：Spring Framework 7 + Jackson 3，仍支持 Java 17。
        -->
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.pm</groupId>
    <artifactId>pm-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>pm-backend</name>
    <description>项目管理系统后端（需求→排期→Bug 管理）</description>

    <properties>
        <!-- 本机为 JDK 18，编译目标为 17（Spring Boot 3 最低要求） -->
        <java.version>17</java.version>
        <!-- 升到 MyBatis-Plus 3.5.17：3.5.15+ 才正式兼容 Spring Boot 4 -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>

        <!--
          覆盖内嵌 Tomcat 版本（Spring Boot 4.1.1 默认带 11.0.24）。
          Trivy 扫出 tomcat-embed-core 两条 CRITICAL：
            · CVE-2026-65182 · CVE-2026-65905   修复版本 11.0.25
          Spring Boot 的 BOM 用 tomcat.version 这个属性管理版本，
          在 properties 里覆盖即可，等官方升到 4.1.2+ 就可以删掉这段。
        -->
        <tomcat.version>11.0.25</tomcat.version>

        <!--
          覆盖 Jackson 版本（Spring Boot 4.1.1 默认：jackson-2 = 2.21.5、jackson-3 = 3.1.5）。

          为什么：2026-10-09 Trivy 扫出 10 条 HIGH，全是 DoS 类、且都「有修复版本」
          （所以 ignore-unfixed 拦不住，硬门禁直接红）。注意这不是代码变更引起的 ——
          同一个 commit 在 09-24 扫是干净的，是漏洞库后来收录/上调了这些 CVE：
            · com.fasterxml.jackson.core:jackson-core      2.21.5 → 修复 2.21.7
            · com.fasterxml.jackson.core:jackson-databind          → 修复 2.21.6
            · tools.jackson.core:jackson-core              3.1.5  → 修复 3.1.7
            · tools.jackson.core:jackson-databind                  → 修复 3.1.6
          取 2.21.7 / 3.1.7 覆盖两条 minor 线的全部所需补丁，都是 patch 级升级，
          兼容风险最低。等官方 BOM 收录后即可删除本段。

          ⚠️ 属性名反直觉，别改错（已核对 spring-boot-dependencies 4.1.1 原文）：
            jackson-2-bom.version → com.fasterxml.jackson:jackson-bom （Jackson 2.x）
            jackson-bom.version   → tools.jackson:jackson-bom       （Jackson 3.x）
        -->
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>

        <!--
          ⚠️ jjwt 暂时保留 0.11.5：0.12.x 起 API 有 breaking change
          （parserBuilder() → parser()），单独升更安全。本轮先把 Spring Boot 4
          跑通，再单独处理 jjwt 与 Jackson 3 的共存问题。
        -->
        <jjwt.version>0.11.5</jjwt.version>
    </properties>

    <dependencies>
        <!-- Web MVC + REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（@Valid / @NotBlank） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          MyBatis-Plus：starter 的 artifactId 绑定 Spring Boot 大版本，
          Boot 3 用 -spring-boot3-starter，Boot 4 必须换成 -spring-boot4-starter，
          否则自动配置不生效（表现为 @Mapper 扫不到、NoSuchBeanDefinition）。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!--
          分页插件：自 MyBatis-Plus 3.5.9 起，PaginationInnerInterceptor 从核心包
          拆了出来，必须显式引入本模块，否则编译报「找不到符号 PaginationInnerInterceptor」。
          版本必须与 starter 保持一致。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Redis（编号流水号、统计缓存） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- BCrypt 密码加密（仅引入 crypto 模块，不引入完整 Spring Security） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JWT 三件套：api 编译期，impl/jackson 运行期 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          集成测试基础设施：Testcontainers 2.x（版本由 Spring Boot BOM 管理）
          ⚠️ 只用 core + mysql 模块，不引 testcontainers-junit-jupiter：
             容器在 AbstractIntegrationTest 静态块中手动启动，避免与 JUnit 6 的扩展兼容问题。
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 架构守护（核心 API，不依赖 JUnit 扩展） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 打包时排除 Lombok（仅编译期使用） -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--
              集成测试（*IT.java）与单元测试分离：
                mvn test        → 只跑 *Test（镜像构建里跑的也是这一层）
                mvn verify      → 额外跑 *IT（需要本机/CI 有 Docker）
              Failsafe 默认只认 *IT / IT* / *ITCase，不会误抓单元测试。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 覆盖率报告：mvn test 后执行 jacoco:report 生成 target/site/jacoco -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <!-- 显式固定版本：Spring Boot BOM 未管理该插件，避免 LATEST 解析导致构建不可复现 -->
                <version>0.8.16</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!--
                              不插桩第三方 SQL 解析器：jsqlparser 的生成式 TokenManager
                              方法体超过 JVM 64KB 限制，JaCoCo 插桩会打印 MethodTooLarge 噪声。
                              与被测代码无关，排除后覆盖率口径不变。
                            -->
                            <excludes>
                                <exclude>net/sf/jsqlparser/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!--
                      覆盖率门禁（只对核心类设硬门槛）：
                        · 状态派生引擎是唯一写 status 的地方，要求 80%
                        · 排期保存规则最密，先按当前基线 35% 起，后续逐步上调
                        · 整体门禁随测试补齐逐轮 ratchet（52% → 55% → 80%，当前实际约 83.5%），
                          读侧服务与需求主流程集成测试补齐后再收紧，避免新增大量无测试代码后静默下滑
                      门槛按「当前基线略低」设置，新增测试后再逐步 ratchet，不做一次性高指标。
                    -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.pm.service.impl.RequirementStageServiceImpl</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.80</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.pm.service.impl.ScheduleServiceImpl</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.65</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.pm.service.impl.ProjectServiceImpl</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.pm.service.impl.FileServiceImpl</include>
                                        <include>com.pm.security.JwtInterceptor</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.pm.service.impl.NotificationServiceImpl</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.pm.service.impl.BugServiceImpl</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.85</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.pm.service.impl.OperationLogServiceImpl</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.75</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
