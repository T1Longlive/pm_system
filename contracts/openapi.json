  "components": {
    "schemas": {
      "ResultLogin": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/LoginResult"
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": [
          "token",
          "userId",
          "username",
          "realName",
          "isAdmin",
          "isPm",
          "forceChangePwd"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "userId": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          },
          "realName": {
            "type": "string"
          },
          "isAdmin": {
            "type": "integer"
          },
          "isPm": {
            "type": "integer"
          },
          "forceChangePwd": {
            "type": "integer"
          }
        }
      },
      "ResultDashboardSummary": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/DashboardSummary"
          }
        }
      },
      "DashboardSummary": {
        "type": "object",
        "required": [
          "unreadNotifications",
          "myRequirementCount",
          "monthEffort",
          "openBugCount"
        ],
        "properties": {
          "unreadNotifications": {
            "type": "integer"
          },
          "myRequirementCount": {
            "type": "integer"
          },
          "monthEffort": {
            "type": "number"
          },
          "openBugCount": {
            "type": "integer"
          }
        }
      },
      "ResultProjectPage": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ProjectPage"
          }
        }
      },
      "ProjectPage": {
        "type": "object",
        "required": ["records", "total"],
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectItem"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "ProjectItem": {
        "type": "object",
        "required": [
          "id",
          "code",
          "name",
          "creatorId",
          "creatorName",
          "memberCount",
          "myRole"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "creatorId": {
            "type": "integer"
          },
          "creatorName": {
            "type": "string"
          },
          "memberCount": {
            "type": "integer"
          },
          "myRole": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ResultRequirementPage": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/RequirementPage"
          }
        }
      },
      "RequirementPage": {
        "type": "object",
        "required": ["records", "total"],
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequirementItem"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "RequirementItem": {
        "type": "object",
        "required": [
          "id",
          "reqNo",
          "projectId",
          "projectName",
          "title",
          "priority",
          "status",
          "updatedAt",
          "participants",
          "myRole"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "reqNo": {
            "type": "string"
          },
          "projectId": {
            "type": "integer"
          },
          "projectName": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RequirementParticipant"
            }
          },
          "myRole": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "RequirementParticipant": {
        "type": "object",
        "required": ["userId", "realName", "craft"],
        "properties": {
          "userId": {
            "type": "integer"
          },
          "realName": {
            "type": "string"
          },
          "craft": {
            "type": "string"
          }
        }
      },
      "ResultScheduleMonthList": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleMonth"
            }
          }
        }
      },
      "ScheduleMonth": {
        "type": "object",
        "required": ["id", "year", "month"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          }
        }
      },
      "ResultScheduleView": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/ScheduleView"
          }
        }
      },
      "ScheduleView": {
        "type": "object",
        "required": ["month", "days", "groups"],
        "properties": {
          "month": {
            "$ref": "#/components/schemas/ScheduleMonth"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarDay"
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleGroup"
            }
          }
        }
      },
      "CalendarDay": {
        "type": "object",
        "required": ["day", "type"],
        "properties": {
          "day": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ScheduleGroup": {
        "type": "object",
        "required": [
          "seq",
          "requirementId",
          "reqNo",
          "title",
          "projectId",
          "projectName",
          "priority",
          "reqStatus",
          "rows"
        ],
        "properties": {
          "seq": {
            "type": "integer"
          },
          "requirementId": {
            "type": "integer"
          },
          "reqNo": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "projectId": {
            "type": "integer"
          },
          "projectName": {
            "type": "string"
          },
          "priority": {
            "type": "integer"
          },
          "reqStatus": {
            "type": "string"
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleRow"
            }
          }
        }
      },
      "ScheduleRow": {
        "type": "object",
        "required": [
          "rowId",
          "craft",
          "userId",
          "realName",
          "status",
          "plannedEffort",
          "scheduledSum",
          "updatedAt",
          "cells"
        ],
        "properties": {
          "rowId": {
            "type": "integer"
          },
          "craft": {
            "type": "string"
          },
          "userId": {
            "type": "integer"
          },
          "realName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "plannedEffort": {
            "type": "number",
            "nullable": true
          },
          "scheduledSum": {
            "type": "number"
          },
          "updatedAt": {
            "type": "integer"
          },
          "cells": {
            "type": "object"
          }
        }
      },
      "ResultBugPage": {
        "type": "object",
        "required": ["code", "data"],
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/BugPage"
          }
        }
      },
      "BugPage": {
        "type": "object",
        "required": ["records", "total"],
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BugItem"
            }
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "BugItem": {
        "type": "object",
        "required": [
          "id",
          "bugNo",
          "projectId",
          "projectName",
          "archived",
          "images",
          "myRole"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "bugNo": {
            "type": "string"
          },
          "projectId": {
            "type": "integer"
          },
          "projectName": {
            "type": "string"
          },
          "archived": {
            "type": "integer"
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BugImage"
            }
          },
          "myRole": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BugImage": {
        "type": "object",
        "required": ["url", "fileName"],
        "properties": {
          "url": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          }
        }
      }
    }
  }
}
