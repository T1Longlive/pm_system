# 依赖与构建产物
node_modules/
dist/
dist-ssr/
target/

# 仓库内置工具链（体积大，不入库）
.tools/

# IDE / 编辑器
.idea/
.vscode/*
!.vscode/extensions.json

# TRAE 本地会话
.trae/

# AI 助手本地目录（工作记忆、会话、内部计划，不入库）
.workbuddy/
.mimocode/

# 日志与本地环境
logs/
*.log
*.local

# 真实环境变量（含凭据，禁止提交；模板见 .env.example）
.env
.env.local
!*.env.example

# 容器运行时挂载的本地配置覆盖
config/application-local.yml
