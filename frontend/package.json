{
  "name": "pm-system-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "内部项目管理系统前端（需求 → 排期 → Bug 管理）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "node e2e/run-local.mjs",
    "perf:smoke": "k6 run perf/smoke.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "pinia": "^4.0.3",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "vxe-pc-ui": "^4.17.28",
    "vxe-table": "^4.21.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.11"
