# ======================================================================
# 换行符与文本规范
# ----------------------------------------------------------------------
# 本仓库在 Windows 上开发、在 Linux 服务器上构建运行。
# 若不加约束，core.autocrlf 可能把 shell 脚本转成 CRLF，
# 而 Linux 上的 bash 遇到 CRLF 会直接报错（如 `bash\r: No such file`），
# 这是容器/CI 场景里非常典型又难查的故障。
# 因此下面显式钉死关键文件的换行符。
# ======================================================================

# 默认：由 git 自动判断，入库统一为 LF
* text=auto eol=lf

# Shell 脚本必须是 LF，否则在 Linux 容器内无法执行
*.sh text eol=lf
*.bash text eol=lf

# 容器与编排文件必须是 LF
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.Dockerfile text eol=lf
docker-compose.yml text eol=lf
docker-compose.*.yml text eol=lf
.dockerignore text eol=lf
*.env text eol=lf
.env.example text eol=lf

# CI 配置必须是 LF
*.yml text eol=lf
*.yaml text eol=lf

# 二进制文件不要做任何转换
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
